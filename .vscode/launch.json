{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kedro: run",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "kedro",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Kedro: run up to a node",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "kedro",
      "args": ["run", "--to-nodes=${input:nodeName}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "nodeName",
      "type": "promptString",
      "description": "Node to stop after (a name from pipeline.py)",
      "default": "clean_data_node"
    }
  ]
}
